# Fingerprint
CONFIG_FINGERPRINT_GOODIX_FOD=m
CONFIG_INPUT_FINGERPRINT=y

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y

# Modem
CONFIG_N_GSM=m

# MTD
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# Power supply
CONFIG_MI_WIRELESS=y
CONFIG_MI_DTPT=y
CONFIG_MI_ENABLE_DP=y

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Touch screen
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# Xiaomi HWID
CONFIG_MI_HARDWARE_ID=m

# Xpad
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# Zram
CONFIG_ZRAM_WRITEBACK=y




CONFIG_XLOGCHAR=m
CONFIG_MIHW=y
CONFIG_QCOM_DYN_MINIDUMP_STACK=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y